{
  "kind": "collectionType",
  "collectionName": "triply_records",
  "info": {
    "singularName": "triply-record",
    "pluralName": "triply-records",
    "displayName": "Triply Record",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "recordId": {
      "type": "string",
      "required": true
    },
    "type": {
      "type": "enumeration",
      "enum": [
        "Archive",
        "Object",
        "People",
        "Publication",
        "Media"
      ],
      "required": true
    },
    "stories": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::story.story",
      "mappedBy": "triplyRecords"
    },
    "label": {
      "type": "string"
    },
    "subject_collectionHighlights": {
      "type": "boolean"
    },
    "story_v_2s": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::story-v2.story-v2",
      "mappedBy": "triply_records"
    }
  }
}
