{
  "kind": "collectionType",
  "collectionName": "stories_v2",
  "info": {
    "singularName": "story-v2",
    "pluralName": "stories-v2",
    "displayName": "Story-v2",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "title": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "string",
      "required": true
    },
    "shortDescription": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "text",
      "required": true
    },
    "author": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::author.author"
    },
    "dateOfPublication": {
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      },
      "type": "date",
      "required": true
    },
    "locations": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::location.location",
      "inversedBy": "story_v_2s"
    },
    "triply_records": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::triply-record.triply-record",
      "inversedBy": "story_v_2s"
    },
    "themes": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::theme.theme",
      "inversedBy": "story_v_2s"
    },
    "timeframe": {
      "type": "component",
      "repeatable": false,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      },
      "component": "core.timeframe"
    },
    "description": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "richtext"
    },
    "optionalModules": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "dynamiczone",
      "components": [
        "modules.title-module",
        "modules.subtitle",
        "modules.text-module",
        "modules.pullquote",
        "modules.image",
        "core.mux-video",
        "core.mux-audio",
        "modules.image-carousel",
        "core.stand-alone-link"
      ]
    },
    "parent_story_v2": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::story-v2.story-v2",
      "inversedBy": "child_stories_v2"
    },
    "child_stories_v2": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::story-v2.story-v2",
      "mappedBy": "parent_story_v2"
    }
  }
}
